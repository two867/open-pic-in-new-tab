{
  "manifest_version": 3,
  "name": "Open Image in New Tab",
  "version": "1.0.0",
  "description": "鼠标悬浮在图片上时，按 Tab 键在新标签页中打开该图片",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
